# Optional bot config. Copy this to `.mini-dep-bot.yml` at the root of
# the target repo to customize what mini-dep-bot touches. All three
# keys are optional — omit any (or the whole file) to use the
# defaults (nothing ignored, nothing pinned, auto-merge off).

# Packages the bot should never open a PR for, no matter how outdated.
ignore:
  - some-noisy-package

# Packages capped to a specific major version — the bot will still
# pick up minor/patch releases within that major, just not jump past
# it. Useful for a dependency you've deliberately held back.
pin:
  some-package: 2

# Auto-merge a manifest's PR once GitHub's required checks pass, but
# only when every bump bundled into it is patch-level (any major/minor
# bump in the batch disables this for that PR). Requires the repo's
# "Allow auto-merge" setting to be turned on — this doesn't bypass
# branch protection or CI, it just queues the merge for when checks
# succeed. Accepts "patch" (or true/yes as aliases); omit for off.
automerge: patch
